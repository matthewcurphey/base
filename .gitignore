# Python bytecode
__pycache__/
*.pyc

# Secrets
.env

# Raw data
etl/data_raw/
*.csv

# ...except dbt seeds — these are version-controlled reference/config
# tables (payout targets, org mappings, overrides), not raw data drops.
!analytics_dbt/seeds/**/*.csv

# DB files
*.db
*.sqlite

# Logs / junk
*.log
*.tmp
*.bak
~$*.xlsx

# Persistent browser profile for SharePoint download automation — holds
# session cookies, not something to version control.
etl/extract/sharepoint/.browser_profile/

# Failure screenshots from browser-automation download scripts (OBIEE, SharePoint)
etl/extract/**/*_debug/

# Power BI
*.pbix

# Productivity report outputs
reports/productivity/results/

# McMaster report outputs (generated daily; template is the only versioned file)
reports/mcmaster/mcmaster_report.xlsx
reports/mcmaster/mcmaster_report_REVIEWED DURING CALL.xlsx
reports/mcmaster/archive/